<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ labels.report_title }} — {{ eqpid }}</title>
<style>
  :root {
    --bg: #f8f9fc;
    --bg-card: #ffffff;
    --bg-card-hover: #f0f2f7;
    --border: #e2e5ea;
    --border-light: #cdd1d9;
    --text: #111827;
    --text-dim: #374151;
    --text-muted: #6b7280;
    --accent: #2563eb;
    --accent-dim: rgba(37,99,235,0.08);
    --green: #059669;
    --green-dim: rgba(5,150,105,0.08);
    --amber: #d97706;
    --amber-dim: rgba(217,119,6,0.08);
    --red: #dc2626;
    --red-dim: rgba(220,38,38,0.08);
    --click-dot: #e11d48;
    --transition-tag: #7c3aed;
    --session-tag: #0284c7;
    --screen-tag: #059669;
    --cluster-tag: #ea580c;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Malgun Gothic', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    padding: 0;
  }

  .report-header {
    background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
    border-bottom: 1px solid var(--border);
    padding: 48px 0 40px;
  }

  .report-header .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .report-header h1 {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
    color: var(--text);
  }

  .report-header .subtitle {
    color: var(--text-dim);
    font-size: 15px;
    font-weight: 400;
  }

  .report-meta {
    display: flex;
    gap: 24px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .meta-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
  }

  .meta-chip .label { color: var(--text-muted); }

  .meta-chip .value {
    color: var(--text);
    font-weight: 500;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px;
  }

  .section { margin-bottom: 48px; }

  .section-title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-title .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--accent-dim);
    color: var(--accent);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Consolas', 'Courier New', monospace;
  }

  /* Summary Cards */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }

  .summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    transition: border-color 0.2s;
  }

  .summary-card:hover { border-color: var(--border-light); }

  .summary-card .card-label {
    font-size: 13px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }

  .summary-card .card-value {
    font-size: 32px;
    font-weight: 700;
    font-family: 'Consolas', 'Courier New', monospace;
    letter-spacing: -1px;
  }

  .summary-card .card-unit {
    font-size: 14px;
    color: var(--text-dim);
    font-weight: 400;
    margin-left: 4px;
  }

  .highlight-green { color: var(--green); }
  .highlight-amber { color: var(--amber); }
  .highlight-accent { color: var(--accent); }
  .highlight-red { color: var(--red); }

  /* Session block */
  .session-block {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .session-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    background: rgba(0,0,0,0.02);
  }

  .session-id {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 15px;
    font-weight: 500;
    color: var(--session-tag);
  }

  .session-stats {
    display: flex;
    gap: 16px;
    font-size: 13px;
    color: var(--text-dim);
  }

  .session-stats span { font-family: 'Consolas', 'Courier New', monospace; }

  .frame-sequence {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .frame-row {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .frame-timeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 60px;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .frame-time {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .frame-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin-top: 8px;
    min-height: 20px;
  }

  .frame-content {
    flex: 1;
    display: flex;
    gap: 16px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
    transition: border-color 0.2s;
  }

  .frame-content:hover { border-color: var(--border-light); }

  .frame-img-wrap {
    position: relative;
    width: 320px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background: #f0f2f7;
    cursor: pointer;
  }

  .frame-img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .click-dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--click-dot);
    border: 1px solid #ffffff;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 6px rgba(225,29,72,0.4);
    z-index: 2;
    pointer-events: none;
  }

  .click-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid rgba(225,29,72,0.25);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .frame-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 4px 0;
  }

  .frame-fname {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
    color: var(--text-dim);
    word-break: break-all;
  }

  .frame-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
  }

  .tag-screen { background: rgba(5,150,105,0.08); color: var(--screen-tag); }
  .tag-transition { background: rgba(124,58,237,0.08); color: var(--transition-tag); }
  .tag-session { background: rgba(2,132,199,0.08); color: var(--session-tag); }
  .tag-cluster { background: rgba(234,88,12,0.08); color: var(--cluster-tag); }

  .frame-coord {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    color: var(--text-dim);
  }

  .frame-coord em {
    color: var(--click-dot);
    font-style: normal;
    font-weight: 500;
  }

  .frame-desc {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .frame-score {
    margin-top: auto;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    color: var(--text-muted);
  }

  .frame-score strong {
    color: var(--accent);
    font-weight: 600;
  }

  /* Pattern Groups */
  .pattern-group {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .pattern-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: var(--accent-dim);
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }

  .pattern-header:hover { background: rgba(37,99,235,0.12); }

  .pattern-label {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .pattern-sequence {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    color: var(--accent);
    margin-left: 12px;
  }

  .pattern-count {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .pattern-toggle {
    font-size: 18px;
    color: var(--text-muted);
    transition: transform 0.2s;
  }

  .pattern-group.open > .pattern-header .pattern-toggle { transform: rotate(180deg); }

  .pattern-body {
    display: none;
    padding: 0;
  }

  .pattern-group.open > .pattern-body { display: block; }

  /* Session Accordion */
  .session-block { margin: 0; border-radius: 0; border-left: none; border-right: none; border-top: none; }
  .session-block:last-child { border-bottom: none; }

  .session-header {
    cursor: pointer;
    user-select: none;
  }

  .session-header:hover { background: rgba(0,0,0,0.03); }

  .session-toggle {
    font-size: 14px;
    color: var(--text-muted);
    transition: transform 0.2s;
    margin-right: 8px;
  }

  .session-block.open > .session-header .session-toggle { transform: rotate(90deg); }

  .frame-sequence {
    display: none;
  }

  .session-block.open > .frame-sequence { display: flex; flex-direction: column; gap: 16px; padding: 24px; }

  /* Signals */
  .signals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 16px;
  }

  .signal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 24px;
  }

  .signal-label {
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .signal-value-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
  }

  .signal-value {
    font-size: 36px;
    font-weight: 700;
    font-family: 'Consolas', 'Courier New', monospace;
    letter-spacing: -1px;
  }

  .signal-unit {
    font-size: 14px;
    color: var(--text-dim);
  }

  .signal-bar-bg {
    width: 100%;
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .signal-bar-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.8s ease;
  }

  .signal-bar-fill.green { background: var(--green); }
  .signal-bar-fill.amber { background: var(--amber); }
  .signal-bar-fill.red { background: var(--red); }

  .signal-verdict {
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 5px;
    display: inline-block;
  }

  .verdict-high { background: var(--green-dim); color: var(--green); }
  .verdict-mid { background: var(--amber-dim); color: var(--amber); }
  .verdict-low { background: var(--red-dim); color: var(--red); }

  /* Sensitivity */
  .sensitivity-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .sensitivity-table th {
    text-align: left;
    padding: 10px 16px;
    background: rgba(0,0,0,0.03);
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sensitivity-table td {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
  }

  .sensitivity-table tr:last-child td { border-bottom: none; }

  /* Verdict */
  .verdict-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    text-align: center;
  }

  .verdict-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 16px;
  }

  .verdict-icon.positive { background: var(--green-dim); }
  .verdict-icon.caution { background: var(--amber-dim); }
  .verdict-icon.negative { background: var(--red-dim); }

  .verdict-title {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .verdict-desc {
    font-size: 15px;
    color: var(--text-dim);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Empty state */
  .empty-state {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 48px 32px;
    text-align: center;
    color: var(--text-muted);
    font-size: 15px;
  }

  /* Footer */
  .report-footer {
    border-top: 1px solid var(--border);
    padding: 24px 40px;
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Image Modal (click to zoom) */
  .img-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    justify-content: center;
    align-items: center;
    cursor: zoom-out;
  }
  .img-modal-overlay.active { display: flex; }

  .modal-img-container {
    position: relative;
    display: inline-block;
  }
  .modal-img-container img {
    display: block;
    max-width: 98vw;
    max-height: 98vh;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.4);
  }
  .modal-click-dot {
    display: none;
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: transparent;
    border: 2px solid #e11d48;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.5);
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .frame-row { flex-direction: column; }
    .frame-timeline { flex-direction: row; width: auto; gap: 8px; }
    .frame-line { width: 40px; height: 1px; min-height: auto; margin-top: 0; }
    .frame-content { flex-direction: column; }
    .frame-img-wrap { width: 100%; }
  }
</style>
</head>
<body>

<div class="report-header">
  <div class="inner">
    <h1>{{ labels.report_title }}</h1>
    <div class="subtitle">{{ labels.report_subtitle }}</div>
    <div class="report-meta">
      <div class="meta-chip">
        <span class="label">{{ labels.report_meta_eqpid }}</span>
        <span class="value">{{ eqpid }}</span>
      </div>
      <div class="meta-chip">
        <span class="label">{{ labels.report_meta_period }}</span>
        <span class="value">{{ date_from }} ~ {{ date_to }}</span>
      </div>
      <div class="meta-chip">
        <span class="label">{{ labels.report_meta_generated }}</span>
        <span class="value">{{ generated_at }}</span>
      </div>
      <div class="meta-chip">
        <span class="label">SnapshotScreener</span>
        <span class="value">{{ version }}</span>
      </div>
    </div>
  </div>
</div>

<div class="container">

  <!-- Section 1: Verdict (moved to top) -->
  <div class="section">
    <h2 class="section-title"><span class="num">1</span> {{ labels.report_section_verdict }}</h2>
    <div class="verdict-box">
      <div class="verdict-icon {% if verdict_color == 'green' %}positive{% elif verdict_color == 'amber' %}caution{% else %}negative{% endif %}">{% if verdict_color == 'green' %}&#x2713;{% elif verdict_color == 'amber' %}&#x26A0;{% else %}&#x2717;{% endif %}</div>
      <div class="verdict-title highlight-{{ verdict_color }}">{{ verdict }}</div>
      <div class="verdict-desc">{{ verdict_desc }}</div>
    </div>
  </div>

  <!-- Section 2: Summary -->
  <div class="section">
    <h2 class="section-title"><span class="num">2</span> {{ labels.report_section_summary }}</h2>
    <div class="summary-grid">
      <div class="summary-card">
        <div class="card-label">{{ labels.report_card_total_clicks }}</div>
        <div class="card-value">{{ "{:,}".format(total_clicks) }}</div>
      </div>
      <div class="summary-card">
        <div class="card-label">{{ labels.report_card_analysis_days }}</div>
        <div class="card-value">{{ analysis_days }}<span class="card-unit">{{ labels.report_card_days_unit }}</span></div>
      </div>
      <div class="summary-card">
        <div class="card-label">{{ labels.report_card_sessions }}</div>
        <div class="card-value">{{ "{:,}".format(session_count) }}</div>
      </div>
      <div class="summary-card">
        <div class="card-label">{{ labels.report_card_screen_groups }}</div>
        <div class="card-value">{{ screen_group_count }}</div>
      </div>
      <div class="summary-card">
        <div class="card-label">{{ labels.report_card_representative_frames }}</div>
        <div class="card-value highlight-accent">{{ representative_count }}</div>
      </div>
      <div class="summary-card">
        <div class="card-label">{{ labels.report_card_reduction_rate }}</div>
        <div class="card-value highlight-green">{{ "%.1f"|format(reduction_rate) }}<span class="card-unit">%</span></div>
      </div>
    </div>
  </div>

  <!-- Section 3: Representative Frames (grouped by pattern) -->
  <div class="section">
    <h2 class="section-title"><span class="num">3</span> {{ labels.report_section_frames }}</h2>

    {% if pattern_groups %}
    {% for group in pattern_groups %}
    <div class="pattern-group{% if loop.first %} open{% endif %}">
      <div class="pattern-header" onclick="this.parentElement.classList.toggle('open')">
        <div>
          <span class="pattern-label">{{ labels.report_pattern_label | replace('{index}', loop.index|string) }}</span>
          <span class="pattern-sequence">{{ group.pattern }}</span>
          <span class="pattern-count">{{ labels.report_session_count | replace('{count}', group.count|string) }}</span>
        </div>
        <span class="pattern-toggle">&#9660;</span>
      </div>
      <div class="pattern-body">
        {% for session in group.sessions %}
        <div class="session-block{% if loop.first %} open{% endif %}">
          <div class="session-header" onclick="this.parentElement.classList.toggle('open')">
            <div style="display:flex;align-items:center;">
              <span class="session-toggle">&#9654;</span>
              <span class="session-id">{{ session.id }}</span>
            </div>
            <div class="session-stats">
              <span>{{ labels.report_clicks_count | replace('{count}', session.click_count|string) }}</span>
              <span>{{ session.time_range }}</span>
              <span>{{ labels.report_rep_frames_count | replace('{count}', session.frame_count|string) }}</span>
            </div>
          </div>
          <div class="frame-sequence">
            {% for frame in session.frames %}
            <div class="frame-row">
              <div class="frame-timeline">
                <span class="frame-time">{{ frame.time }}</span>
                {% if not loop.last %}<div class="frame-line"></div>{% endif %}
              </div>
              <div class="frame-content">
                <div class="frame-img-wrap" {% if frame.original_path %}data-original="{{ frame.original_path }}"{% endif %} data-x-pct="{{ frame.x_pct }}" data-y-pct="{{ frame.y_pct }}">
                  {% if frame.b64 %}
                  <img src="data:image/jpeg;base64,{{ frame.b64 }}" alt="{{ frame.fname }}">
                  <div class="click-dot" style="left:{{ frame.x_pct }}%;top:{{ frame.y_pct }}%;"></div>
                  {% else %}
                  <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:var(--text-muted);font-size:13px;">{{ labels.report_no_image }}</div>
                  {% endif %}
                </div>
                <div class="frame-info">
                  <div class="frame-fname">{{ frame.fname }}</div>
                  <div class="frame-tags">
                    {% for i in range(frame.tags | length) %}
                    <span class="tag {{ frame.tag_classes[i] }}">{{ frame.tags[i] }}</span>
                    {% endfor %}
                  </div>
                  <div class="frame-coord">{{ labels.report_click_coord }} <em>({{ frame.x }}, {{ frame.y }})</em></div>
                  <div class="frame-desc">{{ frame.desc }}</div>
                  <div class="frame-score">candidate_score: <strong>{{ frame.score }}</strong></div>
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="empty-state">{{ labels.report_no_frames }}</div>
    {% endif %}
  </div>

  <!-- Section 4: Pattern Screening Signals -->
  <div class="section">
    <h2 class="section-title"><span class="num">4</span> {{ labels.report_section_signals }}</h2>
    <div class="signals-grid">
      {% if screening.click_concentration is not none %}
      <div class="signal-card">
        <div class="signal-label">{{ labels.report_signal_click_concentration }}</div>
        <div class="signal-value-row">
          <div class="signal-value highlight-{{ screening.click_concentration_color }}">{{ "%.1f"|format(screening.click_concentration * 100) }}</div>
          <div class="signal-unit">%</div>
        </div>
        <div class="signal-bar-bg"><div class="signal-bar-fill {{ screening.click_concentration_color }}" style="width:{{ [screening.click_concentration * 100, 100] | min }}%"></div></div>
        <span class="signal-verdict verdict-{{ screening.click_concentration_verdict_class }}">{{ screening.click_concentration_verdict }}</span>
      </div>
      {% endif %}
      {% if screening.session_cv is not none %}
      <div class="signal-card">
        <div class="signal-label">{{ labels.report_signal_session_cv }}</div>
        <div class="signal-value-row">
          <div class="signal-value highlight-{{ screening.session_cv_color }}">{{ "%.2f"|format(screening.session_cv) }}</div>
        </div>
        <div class="signal-bar-bg"><div class="signal-bar-fill {{ screening.session_cv_color }}" style="width:{{ [screening.session_cv * 100, 100] | min }}%"></div></div>
        <span class="signal-verdict verdict-{{ screening.session_cv_verdict_class }}">{{ screening.session_cv_verdict }}</span>
      </div>
      {% endif %}
      {% if screening.sequence_similarity is not none %}
      <div class="signal-card">
        <div class="signal-label">{{ labels.report_signal_sequence_similarity }}</div>
        <div class="signal-value-row">
          <div class="signal-value highlight-{{ screening.sequence_similarity_color }}">{{ "%.2f"|format(screening.sequence_similarity) }}</div>
        </div>
        <div class="signal-bar-bg"><div class="signal-bar-fill {{ screening.sequence_similarity_color }}" style="width:{{ [screening.sequence_similarity * 100, 100] | min }}%"></div></div>
        <span class="signal-verdict verdict-{{ screening.sequence_similarity_verdict_class }}">{{ screening.sequence_similarity_verdict }}</span>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- Section 5: Parameter Sensitivity -->
  <div class="section">
    <h2 class="section-title"><span class="num">5</span> {{ labels.report_section_sensitivity }}</h2>
    {% if sensitivity is not none %}
    <div class="session-block">
      <div class="session-header">
        <div class="session-id">PHASH_SIMILAR_THRESHOLD sweep: {{ sensitivity.threshold_values }}</div>
      </div>
      <div style="padding:20px">
        <table class="sensitivity-table">
          <thead>
            <tr>
              <th>{{ labels.report_sensitivity_threshold_pair }}</th>
              <th>{{ labels.report_sensitivity_frame_count }}</th>
              <th>{{ labels.report_sensitivity_jaccard }}</th>
              <th>{{ labels.report_sensitivity_verdict }}</th>
            </tr>
          </thead>
          <tbody>
            {% for pair in sensitivity.jaccard_pairs %}
            <tr>
              <td>{{ pair[0] }} vs {{ pair[1] }}</td>
              <td>{{ sensitivity.frame_counts.get(pair[0], "?") }} / {{ sensitivity.frame_counts.get(pair[1], "?") }}</td>
              {% if pair[2] >= 0.7 %}
              <td style="color:var(--green)">{{ "%.2f"|format(pair[2]) }}</td>
              <td><span class="signal-verdict verdict-high">{{ labels.report_sensitivity_stable }}</span></td>
              {% elif pair[2] >= 0.4 %}
              <td style="color:var(--amber)">{{ "%.2f"|format(pair[2]) }}</td>
              <td><span class="signal-verdict verdict-mid">{{ labels.report_sensitivity_moderate }}</span></td>
              {% else %}
              <td style="color:var(--red)">{{ "%.2f"|format(pair[2]) }}</td>
              <td><span class="signal-verdict verdict-low">{{ labels.report_sensitivity_unstable }}</span></td>
              {% endif %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
        <div style="margin-top:16px;">
          <div class="signal-label">{{ labels.report_sensitivity_min_jaccard }}</div>
          <div class="signal-value-row">
            <div class="signal-value highlight-green" style="font-size:24px">{{ "%.2f"|format(sensitivity.min_jaccard) }}</div>
          </div>
          <span class="signal-verdict {% if sensitivity.min_jaccard >= 0.7 %}verdict-high{% elif sensitivity.min_jaccard >= 0.4 %}verdict-mid{% else %}verdict-low{% endif %}">{{ labels["sensitivity_" + sensitivity.sensitivity_verdict] }}</span>
        </div>
      </div>
    </div>
    {% else %}
    <div class="empty-state">{{ labels.report_sensitivity_disabled }}</div>
    {% endif %}
  </div>

</div>

<div class="report-footer">
  {{ labels.report_footer | replace('{version}', version) }}
</div>

<!-- Image zoom modal -->
<div class="img-modal-overlay" id="imgModal">
  <div class="modal-img-container">
    <img id="imgModalContent" src="" alt="{{ labels.report_zoom_alt }}">
    <div class="modal-click-dot" id="modalClickDot"></div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('imgModal');
  var modalImg = document.getElementById('imgModalContent');
  var modalDot = document.getElementById('modalClickDot');

  function showModal(src, xPct, yPct) {
    modalImg.src = src;
    if (xPct && yPct) {
      modalDot.style.left = xPct + '%';
      modalDot.style.top = yPct + '%';
      modalDot.style.display = 'block';
    } else {
      modalDot.style.display = 'none';
    }
    modal.classList.add('active');
  }

  function hideModal() {
    modal.classList.remove('active');
    modalDot.style.display = 'none';
  }

  document.querySelectorAll('.frame-img-wrap').forEach(function(wrap) {
    wrap.addEventListener('click', function() {
      var img = wrap.querySelector('img');
      if (!img) return;

      var originalPath = wrap.getAttribute('data-original');
      var src = originalPath || img.src;
      var xPct = wrap.getAttribute('data-x-pct');
      var yPct = wrap.getAttribute('data-y-pct');

      var probe = new Image();
      probe.onload = function() { showModal(src, xPct, yPct); };
      probe.onerror = function() { showModal(img.src, xPct, yPct); };
      probe.src = src;
    });
  });

  modal.addEventListener('click', hideModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hideModal();
  });
})();
</script>

</body>
</html>
